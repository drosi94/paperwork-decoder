# Copy to .env.local and fill in from Firebase console > Project settings > Your apps.
# .env.local is git-ignored. Never commit App Check debug tokens or service account keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# reCAPTCHA (Google Cloud Fraud Defense) site key, registered in Firebase console > App Check
# under "Fraud Defense". Needed for the hosted build. This key is public.
VITE_RECAPTCHA_SITE_KEY=

# App Check debug token for local development goes in .env.development.local (not here),
# as VITE_APPCHECK_DEBUG_TOKEN=..., so it can never reach a production build.

# Optional: Chrome origin-trial token for WebMCP on your domain (public; it ends up in the page).
# Register at https://developer.chrome.com/origintrials/#/register_trial/4163014905550602241
VITE_WEBMCP_ORIGIN_TRIAL=
