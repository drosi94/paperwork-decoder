{
  "name": "paperwork-decoder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "deploy": "pnpm check && pnpm dlx firebase-tools deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": ">=1.13.6"
    }
  },
  "license": "Apache-2.0",
  "description": "Understand official letters without handing over your identity. Hybrid on-device and cloud AI with Firebase AI Logic.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  }
}
